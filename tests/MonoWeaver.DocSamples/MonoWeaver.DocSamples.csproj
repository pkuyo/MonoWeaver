<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Every code block in docs/ is pulled out of this project with pymdownx.snippets.
    The project is compile-only on purpose: it does not patch a real assembly, it just
    proves that every documented call still exists with the documented signature.
    If the pattern DSL or a rewrite overload changes, this project stops building and
    the docs get fixed in the same commit.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
    <!-- Samples are written for readability, not for warning-free production code. -->
    <NoWarn>$(NoWarn);CS0219;CS0168;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../MonoWeaver/MonoWeaver.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoMod" Version="$(MonoModPackageVersion)" />
    <PackageReference Include="Mono.Cecil" Version="$(CecilPinnedVersion)" />
  </ItemGroup>

</Project>
